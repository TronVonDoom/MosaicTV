generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A library groups one or more root folders to scan (e.g. movies + movies_4k).
model Library {
  id              Int             @id @default(autoincrement())
  name            String
  kind            String // "tv" | "movie" | "other"
  createdAt       DateTime        @default(now())
  // Where its metadata comes from, first to last, as Plex's agent lists its
  // sources: "nfo" (Kodi/Jellyfin .nfo files beside the media), "embedded"
  // (the files' own tags), "tmdb" and "tvdb" (TheTVDB). A detail the first
  // gives wins; the rest fill in what it doesn't have. One left out isn't read.
  metadataSources String          @default("nfo,tmdb,tvdb")
  folders         LibraryFolder[]
  items           MediaItem[]
  shows           Show[]
  showNames       ShowName[]
  airings         Airing[]
}

// Simple key/value store (e.g. the TMDB and TheTVDB API keys).
model Setting {
  key   String @id
  value String
}

// A reusable ffmpeg output profile assignable per channel (null on a channel =
// the built-in default). Human-facing knobs; the stream derives ffmpeg args.
model EncodingProfile {
  id                Int       @id @default(autoincrement())
  name              String
  width             Int       @default(1280)
  height            Int       @default(720)
  fps               Int       @default(30)
  quality           String    @default("medium") // "low" | "medium" | "high"
  hwaccel           String    @default("auto") // "auto" | "nvidia" | "cpu"
  audioBitrate      Int       @default(192) // kbps
  // Encoder tuning. Zero means "derive it" so a profile can stay simple.
  preset            String    @default("auto") // "auto" | encoder-specific speed preset
  videoBitrateK     Int       @default(0) // 0 = derive from quality
  videoBufferK      Int       @default(0) // 0 = derive from bitrate
  scalingMode       String    @default("pad") // "pad" | "stretch" | "crop"
  deinterlace       Boolean   @default(true) // yadif, but only on frames flagged interlaced
  threads           Int       @default(0) // 0 = let ffmpeg decide
  audioChannels     Int       @default(2)
  normalizeLoudness Boolean   @default(false)
  // Burn the first embedded subtitle stream into the picture (for programs that
  // have one). Off by default — it forces a filter and costs a little CPU.
  burnSubtitles     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  channels          Channel[]
}

// An uploaded non-logo media asset (ambient audio, custom filler video),
// managed on the Media page. Files live under the data dir /assets.
model Asset {
  id        Int      @id @default(autoincrement())
  name      String
  kind      String // "audio" | "filler"
  filename  String // stored under the data dir /assets
  mime      String
  sizeBytes Int?
  createdAt DateTime @default(now())
}

// An uploaded logo/watermark image, reusable across channels and blocks.
model Logo {
  id          Int          @id @default(autoincrement())
  name        String
  filename    String // stored under the data dir /logos
  mime        String
  // Per-logo watermark settings (JSON WatermarkConfig). Null = inherit the
  // global default watermark. Lets each logo carry its own mode/size/position/
  // opacity/timing and the constrain-to-media flag.
  watermark   String?
  createdAt   DateTime     @default(now())
  // Bumped when the image is replaced in place (same id, new file), which is
  // what lets the UI cache-bust a swapped logo instead of showing the old one.
  // @default is not optional here: without it this is a NOT NULL column with no
  // default, and `db push` cannot add one to a table that already has rows — it
  // aborts, which takes the whole container down on an existing install.
  updatedAt   DateTime     @default(now()) @updatedAt
  channels    Channel[]
  blocks      TimeBlock[]
  collections Collection[]
  fillers     Filler[]
}

// A show: one row per show in a TV library, and what everything that means
// "this show" points at — its episodes (MediaItem.showId), collection picks and
// broadcast episodes. `title` is what it's called on screen and can be changed;
// the folder names its files are filed under are its ShowNames, so a renamed or
// merged show keeps its files on the next scan.
model Show {
  id               Int              @id @default(autoincrement())
  library          Library          @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId        Int
  title            String
  year             Int?
  tmdbId           Int?
  overview         String?
  genres           String? // comma-separated
  rating           Float?
  // Its poster and backdrop, from the first of its library's sources that has
  // one: a TMDB path like "/abc.jpg", or a TheTVDB image's full address.
  tmdbPosterPath   String?
  tmdbBackdropPath String?
  // How it came by its TMDB match (see TmdbMatch in the contract), and what
  // TMDB calls the show it matched — shown beside the show's own title, and
  // what tells an automatic match that looks wrong.
  tmdbMatch        String?
  tmdbTitle        String?
  tmdbYear         Int?
  // Its match on TheTVDB, kept the same way beside TMDB's.
  tvdbId           Int?
  tvdbMatch        String?
  tvdbTitle        String?
  tvdbYear         Int?
  // What the metadata sources say of it beyond the above (see
  // Library.metadataSources): its rating ("TV-Y7"), network, tagline,
  // creators (comma-separated), cast (JSON [{ name, role, photo }]) and
  // first air date ("1991-08-11").
  contentRating    String?
  network          String?
  tagline          String?
  creators         String?
  cast             String?
  airDate          String?
  // Which order its episodes' details follow, as Plex lets a show pick one:
  // null = as aired, else a TMDB episode group (DVD, absolute, production…)
  // by id or one of TheTVDB's ("tvdb:dvd"), and that order's name. Only that
  // order's source gives episode details then. Its files keep their numbers.
  episodeOrder     String?
  episodeOrderName String?
  // The sources its details came from ("nfo,tmdb"), and when they were last
  // read (null = never — the next fetch reads them).
  metaSources      String?
  metaAt           DateTime?
  updatedAt        DateTime         @updatedAt
  seasons          Season[]
  names            ShowName[]
  episodes         MediaItem[]
  members          CollectionItem[]
  airings          Airing[]
  aired            Aired[]

  @@unique([libraryId, title])
}

// A show title as the scanner reads it off the files (the folder name, cleaned
// up), and the show it files under. A show starts with its own title as its one
// name; merging another show into it adds that one's names, so those files keep
// landing in the merged show on every scan after.
model ShowName {
  id        Int     @id @default(autoincrement())
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId Int
  name      String
  show      Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId    Int

  @@unique([libraryId, name])
  @@index([showId])
}

model Season {
  id             Int     @id @default(autoincrement())
  show           Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId         Int
  number         Int
  tmdbPosterPath String? // TMDB path, or a TheTVDB image's address (as Show's)
  overview       String?

  @@unique([showId, number])
}

// A "broadcast episode": an ordered list of one or more canonical episodes that
// aired together as a single program — how multi-segment cartoons ran on TV
// (Dexter's Laboratory's three shorts, 2 Stupid Dogs interleaving Secret
// Squirrel). Defined per show and stored ONLY here: the underlying files keep
// their real S/E numbering so scrapers (Plex/Jellyfin/TMDB) still match them.
// Segments reference episodes by mediaItemId; a missing/removed file is simply
// skipped when the airing is resolved. A normal episode has no Airing — it is an
// implicit airing of one.
model Airing {
  id        Int             @id @default(autoincrement())
  library   Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId Int
  show      Show            @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId    Int // the show this airing belongs to (its guide title is the show's)
  season    Int? // primary season, for scoping/ordering within the show
  number    Int             @default(0) // running order of airings within the show
  title     String? // optional label override (defaults to the show name)
  createdAt DateTime        @default(now())
  segments  AiringSegment[]

  @@index([showId])
}

// One segment (a canonical episode file) within an Airing, in play order.
model AiringSegment {
  id          Int       @id @default(autoincrement())
  airing      Airing    @relation(fields: [airingId], references: [id], onDelete: Cascade)
  airingId    Int
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  mediaItemId Int
  order       Int       @default(0)

  @@index([airingId])
  @@index([mediaItemId])
}

// A named set of media used to program channels — the "branded unit" (e.g. a
// sub-brand like "Nick Jr."). Owned by one channel; carries its own logo (and,
// later, filler). Members are hand-picked shows and movies; the optional smart
// filter adds a query-based set (unioned in).
model Collection {
  id            Int              @id @default(autoincrement())
  name          String
  // Owning channel (null = orphan/unassigned). Cascade-deletes with the channel.
  channel       Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId     Int?
  // The collection's own on-screen logo (falls back to the channel logo).
  logo          Logo?            @relation(fields: [logoId], references: [id], onDelete: SetNull)
  logoId        Int?
  // The order this collection plays in when a rotation item or time block asks
  // for "inherit" (which is the default for new ones), so a collection airing in
  // several blocks only needs its order set once.
  defaultOrder  String           @default("chronological")
  // Optional smart filter (advanced).
  libraryId     Int?
  filterType    String? // "movie" | "episode" | "other"
  filterShow    String? // exact show title (legacy; prefer members)
  filterSearch  String? // title/show contains
  filterGenre   String? // genre contains
  createdAt     DateTime         @default(now())
  items         CollectionItem[]
  rotationItems RotationItem[]
  timeBlocks    TimeBlock[]

  @@index([channelId])
}

// An ident: what a channel airs during a break (the UI calls breaks "breaks"
// and these "idents"; the code keeps the older name). Each belongs to one
// channel (channelId). Where it plays is its assignments — one channel-level
// row means "everywhere else" (blocks without idents of their own, time
// outside blocks, holds), block rows mean "only during these blocks", and none
// means it plays nowhere.
model Filler {
  id           Int                @id @default(autoincrement())
  channel      Channel?           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId    Int?
  name         String?
  style        String             @default("frosted") // "animated" | "frosted" | "custom"
  assetId      Int? // custom visual (Asset kind "filler"); null for generated styles
  audioAssetId Int? // music (Asset kind "audio"), laid over the break as it airs — never part of the clip
  // Explicit brand logo for the generated (frosted/logo) styles. Null = follow
  // the block: whichever logo is on air where the break falls.
  logo         Logo?              @relation(fields: [logoId], references: [id], onDelete: SetNull)
  logoId       Int?
  // Multiplier on the branded logo's size in the generated styles (1 = default).
  logoScale    Float              @default(1)
  // Frosted glass: draw a divider between the channel's half and MosaicTV's.
  divider      Boolean            @default(false)
  // A break reel: a folder of clips (bumpers, promos, commercials) that a
  // break is filled from, in turn, with the channel's generated look covering
  // what's left (style "reel"). Its clips are ReelClip rows.
  reelFolder   String?
  clips        ReelClip[]
  // Place in its channel's list: the order breaks take turns in.
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  assignments  FillerAssignment[]

  @@index([channelId])
}

// Where an ident plays: a channel-level row ("everywhere else") or one row per
// time block ("only during these blocks"), always on the ident's own channel.
// Deleting the ident, the channel or the block cascades the row away.
model FillerAssignment {
  id          Int        @id @default(autoincrement())
  filler      Filler     @relation(fields: [fillerId], references: [id], onDelete: Cascade)
  fillerId    Int
  channel     Channel?   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   Int?
  timeBlock   TimeBlock? @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  timeBlockId Int?

  @@unique([fillerId, channelId])
  @@unique([fillerId, timeBlockId])
  @@index([channelId])
  @@index([timeBlockId])
}

// A hand-picked member of a collection: a whole show, one season of a show, a
// single episode, a movie, every music video by an artist, or one music video.
// `order` is the user's arrangement — what the "custom" playback order airs.
model CollectionItem {
  id           Int        @id @default(autoincrement())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId Int
  kind         String // "show" | "season" | "episode" | "movie" | "artist" | "album" | "music" | "song"
  show         Show?      @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId       Int? // for kind "show" and "season"
  libraryId    Int? // for kind "show"/"season"/"artist"/"album" (which library it's in)
  season       Int? // for kind "season"
  artist       String? // for kind "artist" and "album", as the music names it (MediaItem.artist)
  album        String? // for kind "album", as the music names it (MediaItem.album)
  mediaItemId  Int? // for kind "movie", "episode" and "music"
  label        String? // denormalized display name
  order        Int        @default(0)
  // Whether this pick brings in the show's season 0, and the show's or the
  // movie's extras. Null = as its channel has it (Channel.includeSpecials /
  // includeExtras); set = this show's own choice, whatever the channel's.
  specials     Boolean?
  extras       Boolean?

  @@index([collectionId])
  @@index([showId])
}

// A virtual TV channel: a container for its collections, a rotation (24/7
// default) + optional time blocks. `number` is optional — a channel with no
// number is a draft (not exposed in the M3U/guide/stream until it gets one).
model Channel {
  id                Int                @id @default(autoincrement())
  number            Int?               @unique
  name              String
  group             String?
  logoUrl           String? // legacy free-form logo URL (fallback)
  logo              Logo?              @relation(fields: [logoId], references: [id], onDelete: SetNull)
  logoId            Int?
  // Output encoding profile (null = built-in default).
  profile           EncodingProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  profileId         Int?
  createdAt         DateTime           @default(now())
  // Playout build state (see playout engine).
  playoutAnchor     DateTime?
  playoutCursor     DateTime?
  playoutState      String? // JSON { rotationIndex, positions }
  // "Coming up next" caption config (JSON ComingUpConfig); null = off. A time
  // block can override this for its own window (TimeBlock.comingUp).
  comingUp          String?
  // A test channel: streamable/previewable but hidden from the public M3U/EPG.
  isTest            Boolean            @default(false)
  // Preferred audio language (ISO 639 tag, e.g. "eng"). Null = use the global
  // setting; "" is never stored. Picks among a file's audio tracks at air time
  // — a dub-first anime channel sets "jpn" without changing the rest.
  audioLanguage     String?
  // Keep the corner logo on screen during breaks. Off: it fades out as a break
  // starts and back in after — the idents already show the logo.
  logoOnBreaks      Boolean            @default(false)
  // The broadcast clock, in minutes (0 = off, or 15, 30, 60): every program
  // starts on the clock's next line — :00 and :30 on a 30 — and the time
  // between is a break. A time block can set its own (TimeBlock.grid).
  grid              Int                @default(0)
  // Breaks inside programs: on a broadcast clock, a program's share of break
  // time is split across its act breaks (MediaItem.breaks) instead of all
  // coming after it. A time block can say otherwise (TimeBlock.actBreaks).
  actBreaks         Boolean            @default(false)
  // What a whole show, a movie or a smart filter brings in on this channel:
  // season 0 (specials, pilots, shorts), and extras (featurettes, trailers…
  // filed with a movie or show). A show's pick can say otherwise
  // (CollectionItem.specials / extras); a special or an extra picked on its
  // own airs either way.
  includeSpecials   Boolean            @default(false)
  includeExtras     Boolean            @default(false)
  // What a song airs over: "album" (its cover, title and progress) or
  // "visualizer" (a spectrum drawn from the song itself). With lyricsFirst,
  // a song that has timed lyrics shows them instead.
  musicScreen       String             @default("album")
  lyricsFirst       Boolean            @default(false)
  // The album look's bottom corners: the program before a song on the left
  // and the one after on the right (see songScreen.ts), in place of the Up
  // next card over a song's last seconds.
  songsAround       Boolean            @default(true)
  // How the guide lists songs and music videos: "hour" folds a run of them
  // into one block an hour, named after their collection (the way a cable
  // guide lists a music channel); "song" lists each on its own.
  musicGuide        String             @default("hour")
  collections       Collection[]
  rotationItems     RotationItem[]
  timeBlocks        TimeBlock[]
  playout           PlayoutItem[]
  aired             Aired[]
  fillers           Filler[] // its idents
  fillerAssignments FillerAssignment[]
}

// One step in a channel's 24/7 rotation.
model RotationItem {
  id            Int        @id @default(autoincrement())
  channel       Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId     Int
  order         Int
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId  Int
  playbackOrder String     @default("chronological") // "chronological" | "shuffle"
  mode          String     @default("one") // "one" | "multiple"
  count         Int        @default(1)

  @@index([channelId])
}

// A day/time block that overrides the rotation while active.
model TimeBlock {
  id                Int                @id @default(autoincrement())
  channel           Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId         Int
  days              String // CSV of day numbers, Sun=0 .. Sat=6, e.g. "1,2,3,4,5"
  startMinute       Int // minutes from local midnight
  endMinute         Int
  collection        Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId      Int
  playbackOrder     String             @default("chronological")
  logoUrl           String? // legacy free-form logo URL (fallback)
  logo              Logo?              @relation(fields: [logoId], references: [id], onDelete: SetNull)
  logoId            Int?
  fillerMode        String             @default("none") // "none" | "between" | "end"
  // "soft" = block starts at the next program boundary (a rotation item may run
  // past the start). "hard" = starts exactly on time; the pre-block gap is filled.
  startMode         String             @default("soft") // "soft" | "hard"
  // Per-block override of the channel's "coming up next" caption (JSON
  // ComingUpConfig); null = inherit the channel's setting.
  comingUp          String?
  // The block's own broadcast clock (see Channel.grid); null = the channel's,
  // 0 = off here.
  grid              Int?
  // Breaks inside programs here (see Channel.actBreaks); null = the channel's.
  actBreaks         Boolean?
  fillerAssignments FillerAssignment[]

  @@index([channelId])
}

// A single scheduled program on a channel's timeline.
model PlayoutItem {
  id           Int        @id @default(autoincrement())
  channel      Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId    Int
  mediaItem    MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  mediaItemId  Int? // null for filler
  kind         String     @default("program") // "program" | "filler"
  title        String? // label for filler / EPG
  startTime    DateTime
  stopTime     DateTime
  // The collection it was scheduled from (a rotation item's or a time
  // block's), which names a block of songs in the guide (musicBlocks.ts).
  // Null on rows built before it was kept. No relation: a deleted
  // collection's rows are replanned away, and a stale id just reads as none.
  collectionId Int?
  // Ties together the consecutive segments of one multi-part airing so the guide
  // can collapse them into a single programme. Unique per scheduled airing
  // ("channelId:startMs"); null for a normal single-file program or filler.
  groupKey     String?
  // Where every collection and the rotation stood just before this program was
  // scheduled (JSON, the playout builder's State) — a checkpoint. Set on the
  // first segment of each program; null on later segments and on filler. A
  // schedule edit cuts the timeline at the next checkpoint and rebuilds from
  // it, so the guide follows the edit without skipping or repeating episodes.
  state        String?
  // How it went on the stream, set by the segmenter as it plays it: "ok", or
  // what went wrong ("held: …"). Null while nobody has watched it.
  streamed     String?
  // Where in the file this row starts, in seconds: set on the second and later
  // acts of a program split at its act breaks (null = the top of the file).
  inPoint      Float?

  @@index([channelId, startTime])
}

// What a channel aired: a program's playout rows, kept once the guide lets
// them go (see aired.ts). Breaks aren't kept. Title and subtitle are as they
// read on air, so the history survives a file going missing; `streamed` is how
// the stream went if anyone was watching (null = nobody was).
model Aired {
  id          Int        @id @default(autoincrement())
  channel     Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   Int
  mediaItem   MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)
  mediaItemId Int?
  show        Show?      @relation(fields: [showId], references: [id], onDelete: SetNull)
  showId      Int?
  // One airing's segments share it, as on the playout row.
  groupKey    String?
  title       String
  subtitle    String?
  startTime   DateTime
  stopTime    DateTime
  streamed    String?

  @@index([channelId, startTime])
  @@index([mediaItemId])
  @@index([showId, startTime])
}

// One clip in a break reel's folder (see Filler.reelFolder), found when the
// ident is saved or its folder is rescanned.
model ReelClip {
  id          Int     @id @default(autoincrement())
  filler      Filler  @relation(fields: [fillerId], references: [id], onDelete: Cascade)
  fillerId    Int
  path        String
  durationSec Float
  hasAudio    Boolean @default(true)
  width       Int?
  height      Int?

  @@index([fillerId])
}

// One root folder belonging to a library.
model LibraryFolder {
  id        Int      @id @default(autoincrement())
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId Int
  path      String   @unique
  createdAt DateTime @default(now())

  @@index([libraryId])
}

// A single video file discovered by the scanner.
model MediaItem {
  id               Int             @id @default(autoincrement())
  library          Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId        Int
  path             String          @unique
  type             String // "movie" | "episode" | "other" | "music"
  title            String
  // An episode's show (null for movies and other files), and its title as
  // shown — kept equal to the show's title, so a rename reaches every place
  // that labels an episode without a join.
  show             Show?           @relation(fields: [showId], references: [id], onDelete: SetNull)
  showId           Int?
  showTitle        String?
  season           Int?
  episode          Int?
  year             Int?
  // Music videos ("music" type): performer and album from the Artist/Album/Title
  // folder layout (or an "Artist - Title" filename). Songs ("song", a Music
  // library's audio files): from their tags first; and their track and disc.
  // `artist` is who music is filed under — a song's album artist where its
  // tags name one, as in Plex — and `trackArtist` who the song itself credits
  // when that's someone else (the singer on a soundtrack, null otherwise).
  artist           String?
  trackArtist      String?
  album            String?
  track            Int?
  disc             Int?
  // A song's timed lyrics beside it ("<song>.lrc"); its tags may carry some too.
  lyricsPath       String?
  // Timed lyrics found on LRCLIB (LRC), for a song with none of its own; ""
  // when it was asked and has none, null when not asked yet.
  lyrics           String?
  durationSec      Float?
  width            Int?
  height           Int?
  videoCodec       String?
  audioCodec       String?
  container        String?
  sizeBytes        Float? // Float (not Int) — file sizes exceed 32-bit; avoids BigInt JSON pain
  mtimeMs          Float? // used to skip re-probing unchanged files
  // Local artwork on disk (Plex/Kodi/Jellyfin naming), served via /api/artwork.
  posterPath       String? // this item's own art (movie poster / episode thumb)
  showPosterPath   String? // show-level art (shared by all episodes of a show)
  seasonPosterPath String? // season-level art (shared by a season's episodes)
  // TMDB metadata (mainly for movies; episodes/other may stay null). The
  // poster and backdrop are the first source's that has one (see Show).
  tmdbId           Int?
  overview         String?
  genres           String? // comma-separated
  rating           Float?
  tmdbPosterPath   String?
  tmdbBackdropPath String?
  // How a movie came by its TMDB match, and what TMDB calls it (see Show).
  tmdbMatch        String?
  tmdbTitle        String?
  tmdbYear         Int?
  // A movie's match on TheTVDB, the same way.
  tvdbId           Int?
  tvdbMatch        String?
  tvdbTitle        String?
  tvdbYear         Int?
  // What the metadata sources say beyond the above (see Show): its title as
  // they give it — an episode's name, shown when the file's own name has none —
  // its first air or release date ("1991-08-11"), rating ("PG-13"), tagline,
  // studio, directors (comma-separated), cast (JSON [{ name, role, photo }])
  // and, for an episode, its still (a TMDB path or a TheTVDB address).
  metaTitle        String?
  airDate          String?
  contentRating    String?
  tagline          String?
  studio           String?
  directors        String?
  cast             String?
  tmdbStillPath    String?
  // The file's own tags (JSON { title, description, date, genre }), read when
  // it's probed; null = not read yet.
  embedded         String?
  // The sources its details came from, and when they were last read (see Show).
  metaSources      String?
  metaAt           DateTime?
  // Act breaks: seconds into the file where it cut to commercial when it aired
  // (JSON number[]), where they came from (chapters | detected | none), and
  // when they were looked for (null = not yet; reset when the file changes).
  breaks           String?
  breaksSource     String?
  breaksCheckedAt  DateTime?
  // A featurette, trailer, deleted scene… filed with a movie or show (see
  // extraKind in scanner/parse.ts); null for the movie or episode itself.
  // A show's extras file under the show (showId, and season when they sit in a
  // season's folder); a movie's belong to the movie (parentId), as in Plex.
  extra            String?
  parent           MediaItem?      @relation("Extras", fields: [parentId], references: [id], onDelete: SetNull)
  parentId         Int?
  extras           MediaItem[]     @relation("Extras")
  missing          Boolean         @default(false)
  addedAt          DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  playouts         PlayoutItem[]
  aired            Aired[]
  airingSegments   AiringSegment[]

  @@index([libraryId])
  @@index([type])
  @@index([showTitle])
  @@index([showId])
  @@index([parentId])
}
