{
  "name": "mosaictv-server",
  "version": "0.15.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/baseline.prisma",
    "db:migrate": "prisma migrate dev",
    "db:rehearse": "tsx scripts/rehearseMigrations.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "compression": "^1.8.2",
    "express": "^4.21.0",
    "opentype.js": "^1.3.4",
    "prisma": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
